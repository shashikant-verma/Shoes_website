# ==============================================================================
# SOLEVIBE E-COMMERCE CONFIGURATION TEMPLATE
# ==============================================================================

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/kinetic_stride
MONGO_URI=mongodb://127.0.0.1:27017/kinetic_stride

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-chars
JWT_EXPIRE=30d

# Server & Network Configuration
PORT=5001
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Frontend API Configuration
REACT_APP_API_URL=http://localhost:5001/api

# Razorpay Payment Gateway (Test or Live Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
REACT_APP_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Transactional Email (Nodemailer / SMTP)
# When left unset or incomplete, email service safely logs emails in console mock mode
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="SoleVibe Footwear" <no-reply@solevibe.com>
SMTP_SECURE=false

# Courier & Shipping Logistics Provider
# Supported providers: mock, bluedart, shiprocket, delhivery
SHIPPING_PROVIDER=mock
SHIPROCKET_EMAIL=your-shiprocket-email@example.com
SHIPROCKET_PASSWORD=your-shiprocket-password
DELHIVERY_API_KEY=your-delhivery-api-token
FREE_SHIPPING_THRESHOLD=2000
STANDARD_SHIPPING_FEE=150
EXPRESS_SHIPPING_FEE=350

# Cloudinary Media Storage (Optional)
# When left unset, image uploads automatically save to public/uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
