{
  "name": "solevibe-shoe-store",
  "version": "1.0.0",
  "description": "SoleVibe shoe e-commerce store built with React",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "server": "cd server && node server.js",
    "server:dev": "cd server && nodemon server.js",
    "seed": "cd server && node seed/seed.js",
    "dev": "concurrently \"npm run server:dev\" \"npm start\"",
    "dev:network": "concurrently \"npm run server\" \"cross-env HOST=0.0.0.0 npm start\"",
    "install:all": "npm install && npm install -g nodemon",
    "kill:node": "taskkill /F /IM node.exe || true",
    "start:fresh": "npm run kill:node && npm run server"
  },
  "dependencies": {
    "@react-three/drei": "^9.88.0",
    "@react-three/fiber": "^8.15.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "three": "^0.186.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14"
  }
}
